# EXAMPLE — Okta OIDC client credentials override for Secret/okta-client.
# The real file `secret-patch.yaml` is gitignored; create it from this example:
#     cp secret-patch.yaml.example secret-patch.yaml
# Plain Secret + stringData + JSON patch keeps ${VAR} visible to Flux postBuild (no secretGenerator).
- op: replace
  path: /stringData/client-id
  value: "${OKTA_CLIENT_ID}"
- op: replace
  path: /stringData/client-secret
  value: "${OKTA_CLIENT_SECRET}"
