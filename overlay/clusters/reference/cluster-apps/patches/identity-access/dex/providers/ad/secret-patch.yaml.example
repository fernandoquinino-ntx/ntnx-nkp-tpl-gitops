# EXAMPLE — Dex ldap-bind password override (overlay `reference`).
#
# This file is committed as a TEMPLATE. The real file `secret-patch.yaml` is gitignored.
# Before applying, create it from this example:
#
#     cp secret-patch.yaml.example secret-patch.yaml
#     # ...then edit secret-patch.yaml (set the real password, or keep ${VAR} for Flux)
#
# The component (`kustomization.yaml`) references `secret-patch.yaml`, so the overlay will
# NOT build until that file exists.
#
# NOTE (live lab): the `kommander/ldap-bind` Secret is ESO-managed from Vault KV
# `secret/ldap-bind` — a manual `kubectl apply` is reverted. Change the value in Vault.
- op: replace
  path: /stringData/password
  value: "${DEX_LDAP_BIND_PASSWORD}"
