# .env.example — copy to `.env` (gitignored) for `scripts/render.sh <cluster>`.

# --- AD (ldap), default provider ---
DEX_LDAP_HOST="dc01.ad.example.local:636"
DEX_LDAP_BIND_DN="CN=svc-nkp,CN=Users,DC=ad,DC=example,DC=local"
DEX_LDAP_USER_BASE_DN="DC=ad,DC=example,DC=local"
DEX_LDAP_GROUP_BASE_DN="DC=ad,DC=example,DC=local"
DEX_LDAP_BIND_PASSWORD="PLACEHOLDER_PASSWORD"
DEX_LDAP_INSECURE_SKIP_VERIFY="true"
DEX_LDAP_ROOT_CA_PEM="PLACEHOLDER_CA_PEM"   # used only when CA trust is enabled

# --- Okta (oidc), provider switch ---
OKTA_ISSUER="https://example.okta.com/oauth2/default"
OKTA_REDIRECT_URI="https://kommander.example.com/dex/callback"
OKTA_CLIENT_SECRET_NAME="okta-client"
OKTA_CLIENT_ID="0oaXXXXXXXXXXXXXXXX"
OKTA_CLIENT_SECRET="PLACEHOLDER_OKTA_CLIENT_SECRET"
OKTA_GROUP="NKP-Admins"
